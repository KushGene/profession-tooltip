# Packaging for CurseForge / Wago / GitHub Releases (BigWigs Packager)
# Note: no comments after entries – the packager would read them as part of the path.
package-as: ProfessionTooltip

# Only the released version's section from CHANGELOG.md; the file is generated by
# .github/scripts/extract_changelog.py in the release workflow.
manual-changelog:
  filename: .release-notes.md
  markup-type: markdown

# Tools = data generator, not needed in game
ignore:
  - Tools
  - README.md
  - DEVELOPMENT.md
  - CHANGELOG.md
  - .release-notes.md
